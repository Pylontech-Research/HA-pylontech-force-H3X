{
  "title": "Pylontech Force H3X",
  "config": {
    "step": {
      "user": {
        "title": "Connect to Force H3X",
        "description": "Connect directly to the local FH3X Modbus TCP endpoint. No cloud account is required.",
        "data": {
          "host": "IP address",
          "port": "Port"
        },
        "data_description": {
          "host": "The local IP address assigned to the FH3X.",
          "port": "The Modbus TCP port. The protocol default is 502."
        }
      },
      "reconfigure": {
        "title": "Update FH3X connection",
        "description": "Change the local connection details and verify the same device before saving.",
        "data": {
          "host": "IP address",
          "port": "Port"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect. Check the IP address, port, network route, and whether Modbus TCP is enabled.",
      "invalid_response": "The device responded, but the response is not a valid FH3X PCS identity.",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This FH3X is already configured.",
      "unique_id_mismatch": "The new address belongs to a different FH3X."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "FH3X integration settings",
        "data": {
          "scan_interval": "Update interval",
