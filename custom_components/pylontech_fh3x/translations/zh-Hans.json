{
  "title": "派能 Force H3X",
  "config": {
    "step": {
      "user": {
        "title": "连接 Force H3X",
        "description": "通过局域网直接连接 FH3X 的 Modbus TCP 接口，不需要云端账号。",
        "data": {
          "host": "IP 地址",
          "port": "端口"
        },
        "data_description": {
          "host": "FH3X 在局域网中的 IP 地址。",
          "port": "Modbus TCP 端口，协议默认值为 502。"
        }
      },
      "reconfigure": {
        "title": "更新 FH3X 连接",
        "description": "修改局域网连接参数，保存前会验证是否为同一台设备。",
        "data": {
          "host": "IP 地址",
          "port": "端口"
        }
      }
    },
    "error": {
      "cannot_connect": "无法连接。请检查 IP、端口、网络路由以及设备是否已开启 Modbus TCP。",
      "invalid_response": "设备有响应，但返回内容不是有效的 FH3X PCS 身份信息。",
      "unknown": "发生未知错误"
    },
    "abort": {
      "already_configured": "这台 FH3X 已经配置。",
      "unique_id_mismatch": "新地址连接到的是另一台 FH3X。"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "FH3X 集成设置",
        "data": {
          "scan_interval": "更新间隔",
          "detailed_bms": "详细模块与电芯数据",
          "entity_profile": "实体详细程度",
          "control_profile": "控制开放级别"
        },
        "data_description": {
          "scan_interval": "两次读取之间的秒数，最小为 5 秒。",
          "detailed_bms": "读取全部可用模块和电芯的电压、温度；会增加多次 Modbus 请求及大量默认禁用的诊断实体。",
          "entity_profile": "compact 为关键能源数据；standard 增加三相、分路光伏、电池和 EPS 常用数据；engineering 开放全部支持点位。",
          "control_profile": "日常控制显示 EMS、EPS 和四个计划启用开关；常用设置增加手动功率与 SOC 限值；高级模式开放完整计划、削峰、热泵和馈电参数。"
        }
      }
    }
  },
